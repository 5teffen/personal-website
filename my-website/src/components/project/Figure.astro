---
/**
 * A figure with a caption. `width` controls how far it spreads.
 *   text  stays in the text column
 *   wide  spans the text and margin columns (default)
 *   full  spans the window
 *
 * In MDX, pass the caption as a prop, <Figure caption="...">. Named slots are
 * not picked up from MDX children.
 */
interface Props {
  width?: "text" | "wide" | "full";
  id?: string;
  /** Plain-text caption. Use the "caption" slot instead when it needs markup. */
  caption?: string;
}
const { width = "wide", id, caption } = Astro.props;
---
<figure class:list={["figure", width === "text" ? null : width]} id={id}>
  <slot />
  {Astro.slots.has("caption") ? (
    <figcaption><slot name="caption" /></figcaption>
  ) : caption ? (
    <figcaption>{caption}</figcaption>
  ) : null}
</figure>

<style>
  .figure { margin: var(--space-4) 0; }
  .figure.full { padding: 0 var(--edge); }
  figcaption {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--ink-muted);
    margin-top: var(--space-1);
    max-width: var(--measure);
  }
  .figure :global(img) { display: block; width: 100%; }
</style>
